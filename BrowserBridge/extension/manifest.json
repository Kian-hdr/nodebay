{
  "manifest_version": 3,
  "name": "Nodebay Browser Media Bridge",
  "version": "0.1.0",
  "description": "Exposes explicitly permitted YouTube media tabs to the local Nodebay app.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["media.js"],
      "run_at": "document_idle"
    }
  ]
}
